# Copy this file to ".env" and fill in real values.
# NEVER commit the real ".env" file to GitHub.

APP_NAME=Civic Service AI Assistant
ENVIRONMENT=development
DEBUG=true

# We'll fill these in from Phase 3 onwards (database) and Phase 4 (auth).
# Replace YOUR_PASSWORD with the PostgreSQL superuser password you set
# during installation. Keep the database name as civic_db (or whatever
# you named it in pgAdmin) — they must match.
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/civic_db

# Phase 4 — authentication. Change this to any long random string —
# it's the secret key used to sign login tokens. Never share it or
# commit the real value; the placeholder below is fine for coursework.
JWT_SECRET_KEY=civic-service-dev-secret-change-this-to-something-random
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
